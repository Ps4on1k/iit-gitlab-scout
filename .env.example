# PostgreSQL credentials
POSTGRES_USER=gitlab_scout
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gitlab_scout
DATABASE_URL=postgresql://gitlab_scout:changeme@postgres:5432/gitlab_scout

# Application secrets
JWT_SECRET=changeme-at-least-16-chars
ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Caddy / SSL
# Only Caddy is exposed to host. Frontend/backend are internal Docker network only.
# For production with Let's Encrypt: set DOMAIN + TLS_EMAIL + standard ports
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
# DOMAIN=gitlab-scout.example.com
# TLS_EMAIL=admin@example.com
