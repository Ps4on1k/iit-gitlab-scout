# ============================================
# GitLab Scout Backend — Environment Configuration
# ============================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# DATABASE_URL, JWT_SECRET, ENCRYPTION_KEY are expected from the root .env.

# --------------------------------------------
# GitLab API
# --------------------------------------------
# Default base URL for GitLab API v4.
# Individual projects can override this in the DB.
GITLAB_BASE_URL=https://gitlab.com/api/v4

# --------------------------------------------
# Server
# --------------------------------------------
PORT=3000
HOST=0.0.0.0

# --------------------------------------------
# Request settings
# --------------------------------------------
REQUEST_TIMEOUT=30000
RATE_LIMIT_RPS=10
CACHE_TTL=300

# --------------------------------------------
# CORS
# --------------------------------------------
# Comma-separated list of allowed origins.
# Leave empty or unset to allow all origins (dev mode).
# Example: CORS_ORIGINS=http://localhost:8080,https://gitlab-scout.example.com
CORS_ORIGINS=
